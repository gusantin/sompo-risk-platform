# Somente o servidor Next.js acessa estes valores. Não use NEXT_PUBLIC_ para credenciais.
# Optional. Leave blank on Vercel for the bundled presentation snapshot.
# Local development alone defaults to http://127.0.0.1:5000.
SOMPO_BACKEND_URL=
SOMPO_BACKEND_API_KEY=

# Local development only. Production requires real user authentication first.
SOMPO_ENABLE_ALERT_ACTIONS=false

# Local development only: seed_demo --export output, explicit DEMO mode.
SOMPO_DEMO_SCENARIO_PATH=

# Local development only: explicit canonical snapshot override. Ignored in production.
PRESENTATION_PORTFOLIO_PATH=
