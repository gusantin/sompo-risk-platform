# Caminho local da credencial. Nunca versione o arquivo apontado aqui.
API_CONTRACT_VERSION=1
ENVIRONMENT=development
HOST=0.0.0.0
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Chaves locais não devem ser versionadas. Em produção, configure uma ou mais.
APP_API_KEYS=
ALLOW_DEV_AUTH_BYPASS=false
ALLOW_DEV_DEVICE_BYPASS=false
FIREBASE_KEY_PATH=firebase-key.json
TEMPERATURA_MIN_C=-40
TEMPERATURA_MAX_C=85
IDENTIFICADOR_MAX_LENGTH=100
JSON_MAX_BYTES=16384
MAX_MEASUREMENTS=50
DEVICE_TOKEN_HASH_ITERATIONS=120000
DEVICE_STALE_AFTER_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=1800
IOT_RATE_LIMIT_REQUESTS=120
IOT_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_REQUESTS=10
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60
ALERT_COOLDOWN_SECONDS=3600
ALERT_HOTSPOT_DISTANCE_KM=5
ALERT_HOTSPOT_CRITICAL_DISTANCE_KM=1
HOTSPOT_MAX_AGE_HOURS=24
OPERATIONAL_HOTSPOT_DISTANCE_KM=10
EVENT_SIGNIFICANT_SCORE_DELTA=15
IOT_MAX_AGE_MINUTES=15
IOT_MAX_AGE_SECONDS=900
MACHINE_LOCATION_MAX_AGE_SECONDS=900
TELEMETRY_DEFAULT_LIMIT=20
TELEMETRY_MAX_LIMIT=100
PROPERTY_TELEMETRY_QUERY_LIMIT=1000
RISK_HISTORY_DEFAULT_LIMIT=20
RISK_HISTORY_MAX_LIMIT=100
REGIONAL_CACHE_TTL_SECONDS=1800
REGIONAL_MAX_CONCURRENCY=4
REGIONAL_MAX_LOCATIONS=20
REGIONAL_JOB_MAX_LOCATIONS=300
REGIONAL_READ_MAX_LIMIT=200
REGIONAL_STALE_AFTER_SECONDS=7200
EXTERNAL_API_BUDGET_SECONDS=25
LIVE_CASE_SNAPSHOT_PATH=data/live_showcase_cases.json
LIVE_CASE_MAX_AGE_SECONDS=21600
LIVE_CASE_MONITORED_STATES=MT,MS,GO,MG,PR
LIVE_CASE_MAX_WORKERS=3
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
SOMPO_AGENT_TIMEOUT_SECONDS=120
ENABLE_FIREBASE_TEST_ROUTE=false
RUN_FIREBASE_INTEGRATION_TESTS=0
FIREBASE_TEST_PROJECT_ACK=

